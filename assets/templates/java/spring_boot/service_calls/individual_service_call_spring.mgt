/**
 * wird aktuell nicht benutzt; Funktionalität aus service_calls.mgt könnte hier her ausgelagert werden
 */
private Mono<Object> {{this.name}}() {
    String host = System.getenv("{{this.host_env_var}}");
    if (host == null || host.isEmpty()) {
        String errorMessage = "ERROR: Environment variable '{{this.host_env_var}}' is not set!";
        System.err.println(errorMessage);
        return Mono.error(new IllegalStateException(errorMessage));
    }

    String baseUrl = "http://" + host + ":80";
    String path = "{{this.path}}";

    return this.webClient
        .method(HttpMethod.valueOf("{{this.http_method_uppercase}}"))
        .uri(uriBuilder -> {
            uriBuilder.scheme("http").host(host).port(80).path(path);
            {{#if this.requires_data}}
            String fakeHashInput = faker.lorem().characters(10, 30, true, true);
            System.out.println("[DEBUG]   Generated fake data for positional0: '" + fakeHashInput + "'");
            uriBuilder.queryParam("positional0", fakeHashInput);
            {{/if}}

            URI finalUri = uriBuilder.build();
            System.out.println("[DEBUG]   Final URI constructed for {{this.name}}: " + finalUri.toString());
            return finalUri;
        })
        .retrieve()
        .bodyToMono(Object.class)
        .doOnError(e -> System.err.println("ERROR calling " + baseUrl + path + ": " + e.getMessage()))
        .onErrorResume(e -> Mono.empty());
}
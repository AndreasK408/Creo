    /**
     * Performs an individual service call to {{this.target_service_name}}{{this.target_endpoint_path}}.
     * Method: {{this.http_method_uppercase}}
     */
    private Object {{this.individual_call_function_name}}() {
        String baseUrl = "http://{{this.target_service_name}}:80";
        String url = baseUrl + "{{this.target_endpoint_path}}";

        HttpMethod method = HttpMethod.valueOf("{{this.http_method_uppercase}}");
        HttpHeaders headers = new HttpHeaders();
        {{#if this.is_post_or_put_request}}
        headers.setContentType(MediaType.APPLICATION_JSON);
        {{/if}}
        HttpEntity<?> requestEntity;

        {{#if this.is_post_or_put_request}}
        {{this.complex_param_type}} bodyData = null;
        {{#if this.complex_param_function_name}}
        bodyData = this.{{this.complex_param_function_name}}();
        {{/if}}
        requestEntity = new HttpEntity<>(bodyData, headers);
        {{else}}
        UriComponentsBuilder uriBuilder = UriComponentsBuilder.fromHttpUrl(url);
        {{#if this.query_data_function_name}}
        MultiValueMap<String, String> queryParams = this.{{this.query_data_function_name}}();
        uriBuilder.queryParams(queryParams);
        {{/if}}
        url = uriBuilder.toUriString();
        requestEntity = new HttpEntity<>(headers);
        {{/if}}
        System.out.println("Making " + method + " request to: " + url + (requestEntity.getBody() != null ? " with body" : ""));

        try {
            ResponseEntity<String> response = restTemplate.exchange(url, method, requestEntity, String.class);
            return response.getBody();
        } catch (org.springframework.web.client.HttpClientErrorException e) {
            System.err.println("HTTP Client Error calling " + url + ": " + e.getStatusCode() + " - " + e.getResponseBodyAsString());
            throw e;
        } catch (org.springframework.web.client.RestClientException e) {
            System.err.println("REST Client Error calling " + url + ": " + e.getMessage());
            throw e;
        }
    }

         /**
         * GET {{this.path}}
         {{#if this.description}}
         * {{this.description}}
         {{/if}}
         */
        @GetMapping(path = "{{this.path}}")
        public ResponseEntity<?> {{this.name}}(
            {{#each this.query_params as |qp|}}
            @RequestParam(name = "{{qp.name}}") {{qp.param_type}} {{qp.name}}{{#unless @last}},{{/unless}}
            {{/each}}
        ) {
            try {
                {{#if this.has_return_type}}
                Object result = {{this.handler_func_name}}(
                    {{#each this.handler_args as |arg|}}
                    {{arg.name}}{{#unless @last}}, {{/unless}}
                    {{/each}}
                );
                {{else}}
                {{this.handler_func_name}}(
                    {{#each this.handler_args as |arg|}}
                    {{arg.name}}{{#unless @last}}, {{/unless}}
                    {{/each}}
                );
                {{/if}}

                {{#if this.has_service_calls}}
                System.out.println("Executing service calls for GET {{this.path}}...");
                {{{this.service_call_function_name}}}();
                {{/if}}

                {{#if this.has_return_type}}
                return ResponseEntity.ok(result);
                {{else}}
                return ResponseEntity.noContent().build();
                {{/if}}
            } catch (IllegalArgumentException e) {
                System.err.println("Client error in GET {{this.path}}: " + e.getMessage());
                return ResponseEntity.badRequest().body(Map.of("error", e.getMessage()));
            } catch (Exception e) {
                System.err.println("Server error in GET {{this.path}}: " + e.getMessage());
                e.printStackTrace();
                return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body(Map.of("error", "An internal server error occurred."));
            }
        }
    